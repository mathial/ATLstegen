{% form_theme form 'bootstrap/bootstrap_3_layout.html.twig' %}

    {% extends "common/layout.html.twig" %}

    {% block body %}

    <div class="form">
        {{ form(form) }}
    </div>

    <h3>League Standings - Round #{{ round }}</h3>

    <p><i>P : matches played - W : wins - T : ties - L : losses - EP : extra points </i></p>

    <div class="table-responsive">

        <table class="table">

            <thead>
                <tr>
                    <th>#</th>
                    <th>Player</th>
                    <th>Points</th>
                    <th>EP</th>
                    <th>W</th>
                    <th>T</th>
                    <th>L</th>
                    <th>P</th>
                </tr>
            </thead>

            <tbody>
                {% set rank = 1 %}
                {% set oldPts = -1 %}
                {% for playerId, data in standings %}

                    <tr>
                        <td>{% if data.points == oldPts %}
                              -
                            {% else %}
                              {{ rank }}
                            {% endif %}
                        </td>

                        <td>
                            <a href="{{ path('player_view', {'id': data.player.id}) }}">
                                {{ data.player.nameshort }}
                            </a>
                        </td>

                        <td><strong>{{ data.points }}</strong></td>
                        <td>{% if data.extrapoints > 0 %}
                            (+ {{ data.extrapoints }})
                        {% endif %}</td>
                        <td>{{ data.wins }}</td>
                        <td>{{ data.ties }}</td>
                        <td>{{ data.losses }}</td>
                        <td>{{ data.played }}</td>
                    </tr>

                    {% set oldPts = data.points %}
                    {% set rank = rank + 1 %}
                {% else %}

                    <tr>
                        <td colspan="6">No participants found for this round.</td>
                    </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>


    {% endblock %}